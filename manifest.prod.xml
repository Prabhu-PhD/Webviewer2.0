<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>b78a992d-9f5b-43d8-8422-99abfe32e01b</Id>
  <Version>2.0.5.0</Version>
  <ProviderName>Prabhu Palanichamy</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Webviewer 2.0"/>
  <Description DefaultValue="Embed live web pages directly on a PowerPoint slide — dashboards, Google Slides, Looker Studio, Power BI, Miro, Figma, Padlet, Mentimeter, Google Forms, Microsoft Forms, maps, and more. Paste a URL and it appears as a live frame inside your presentation. Most public pages embed instantly; some sites that block framing can be opened in a browser or shared via QR. Supports split-screen with up to 4 URLs, auto-refresh, draw mode, mobile view, zoom, and QR sharing. Free replacement for the retired Microsoft Web Viewer add-in."/>
  <IconUrl DefaultValue="https://prabhu-phd.github.io/Webviewer2.0/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://prabhu-phd.github.io/Webviewer2.0/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://prabhu-phd.github.io/Webviewer2.0/support.html"/>
  <PrivacyStatementUrl DefaultValue="https://prabhu-phd.github.io/Webviewer2.0/privacy.html"/>
  <TermsOfUseUrl DefaultValue="https://prabhu-phd.github.io/Webviewer2.0/terms.html"/>
  <AppDomains>
    <AppDomain>https://prabhu-phd.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ActiveView" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://prabhu-phd.github.io/Webviewer2.0/content.html?v=16"/>
    <RequestedWidth>720</RequestedWidth>
    <RequestedHeight>420</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
