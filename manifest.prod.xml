<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:type="ContentApp">
  <Id>b78a992d-9f5b-43d8-8422-99abfe32e01b</Id>
  <Version>2.0.3.0</Version>
  <ProviderName>Webviewer2</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Webviewer 2.0"/>
  <Description DefaultValue="Embed live, secure web content directly on a PowerPoint slide."/>
  <IconUrl DefaultValue="https://prabhu-phd.github.io/Webviewer2.0/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://prabhu-phd.github.io/Webviewer2.0/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://prabhu-phd.github.io/Webviewer2.0/support.html"/>
  <AppDomains>
    <AppDomain>https://prabhu-phd.github.io</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Presentation"/>
  </Hosts>
  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="ActiveView" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://prabhu-phd.github.io/Webviewer2.0/content.html?v=12"/>
    <RequestedWidth>720</RequestedWidth>
    <RequestedHeight>420</RequestedHeight>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
</OfficeApp>
